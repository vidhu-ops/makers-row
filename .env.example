CANVA_CLIENT_ID=replace_with_canva_client_id
CANVA_CLIENT_SECRET=replace_with_canva_client_secret
CANVA_REDIRECT_URI=http://127.0.0.1:8765/api/canva/oauth/callback
CANVA_BRAND_TEMPLATE_ID=replace_with_autofillable_brand_template_id
# Optional JSON field mapping if your Canva template uses different names.
# Example: {"title":"TITLE","brief":"BRIEF","style":"STYLE","reference1":"REFERENCE_1"}
CANVA_AUTOFILL_FIELDS_JSON={"title":"TITLE","brief":"BRIEF","style":"STYLE","reference1":"REFERENCE_1","reference2":"REFERENCE_2","reference3":"REFERENCE_3"}

# Shared buyer/designer CRM (run supabase/schema.sql first)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_supabase_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_browser_safe_supabase_key
RESEND_API_KEY=replace_with_resend_key
